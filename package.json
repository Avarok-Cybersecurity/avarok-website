{
  "name": "avarok-website",
  "private": true,
  "description": "avarok.net: the static site in site/ (generated by tools/build.py) and the atlas.avarok.net redirect Worker.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "python3 tools/build.py",
    "preview": "wrangler pages dev site --port 8788 --ip 127.0.0.1 --compatibility-date=2026-09-01",
    "test:unit": "node --test \"tests/unit/*.test.mjs\" \"workers/atlas-redirect/test/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:links": "LINKS_LIVE=1 playwright test e2e/links.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "wrangler": "4.153.0"
  }
}
